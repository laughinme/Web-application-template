# Compose project name
COMPOSE_PROJECT_NAME=monolith-template

# Public app URL (for links and storage public URL)
SITE_URL=http://localhost
STORAGE_ENDPOINT_PUBLIC=http://localhost

# Cookie policy for local/demo
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# Demo admin credentials (used by demo seeder)
DEMO_ADMIN_EMAIL=admin@demo.local
DEMO_ADMIN_PASSWORD=Admin12345!
DEMO_ADMIN_USERNAME=Demo Admin

# Notifications
NOTIFICATIONS_ENABLED=true
EMAIL_PROVIDER=noop
RESEND_API_KEY=
EMAIL_FROM=noreply@example.com
EMAIL_REPLY_TO=

TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_URL=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_PARSE_MODE=HTML
TELEGRAM_LINK_TOKEN_TTL_SEC=900

NOTIFICATION_MAX_ATTEMPTS=5
NOTIFICATION_PROCESSING_TIMEOUT_SEC=300
NOTIFICATION_DISPATCH_BATCH_SIZE=100

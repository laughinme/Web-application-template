# Local development settings. `make env` copies this file to backend/.env.
# Variable names are case-insensitive; see app/core/config.py for every option.

APP_STAGE=dev
DEBUG=true
LOG_LEVEL=INFO
LOG_JSON=false

# Postgres and Redis from `make up` (docker-compose.yml) are published on these ports.
DATABASE_URL=postgresql+asyncpg://postgres:secret@localhost:5432/templatepg
REDIS_URL=redis://localhost:6379/0

# `make keys` generates the pair into backend/secrets/.
JWT_PRIVATE_KEY_PATH=./secrets/jwt_private_key.pem
JWT_PUBLIC_KEY_PATH=./secrets/jwt_public_key.pem
# Or inline (e.g. from a secret manager):
# JWT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
# JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"
ACCESS_TTL=900
REFRESH_TTL=2592000
# Production refuses to start with the default value.
CSRF_HMAC_KEY=change-me

COOKIE_SECURE=false
COOKIE_SAMESITE=lax
COOKIE_DOMAIN=

# Only when the SPA calls the API from another origin (no nginx in front).
CORS_ALLOW_ORIGINS=http://localhost:5173

# S3-compatible storage. Locally: RustFS from docker-compose.yml.
STORAGE_ENDPOINT_INTERNAL=http://localhost:9000
STORAGE_ENDPOINT_PUBLIC=http://localhost:9000
STORAGE_ACCESS_KEY=rustfsadmin
STORAGE_SECRET_KEY=rustfsadmin
STORAGE_PUBLIC_BUCKET=media-public
STORAGE_AUTO_CREATE_BUCKETS=true
MAX_AVATAR_SIZE_MB=5

# log | telegram. Delivered by the worker (python -m app.worker).
NOTIFICATIONS_PROVIDER=log
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
